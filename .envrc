source /opt/ros/jazzy/setup.bash

if [ -f install/setup.bash ]; then
  source install/setup.bash
fi

# Add the repo .venv (pip-only deps like pylsl, see scripts/setup-python-env) to
# PYTHONPATH so direnv shells and the editor LSP import them. Use an absolute path
# (direnv evaluates this at the repo root) so it still resolves from subdirectories.
for _site_packages in "${PWD}"/.venv/lib/python*/site-packages; do
  if [ -d "$_site_packages" ]; then
    export PYTHONPATH="${_site_packages}${PYTHONPATH:+:${PYTHONPATH}}"
    break
  fi
done
unset _site_packages
