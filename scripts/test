#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=scripts/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

enter_ros_workspace

test_status=0
result_status=0
colcon test "$@" || test_status=$?
colcon test-result --verbose || result_status=$?

if [ "$result_status" -ne 0 ]; then
  exit "$result_status"
fi
exit "$test_status"
