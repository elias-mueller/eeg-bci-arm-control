#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=scripts/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

cd "$repo_root"
prepend_pipx_bin
ensure_ruff

args=("$@")
if [ "${#args[@]}" -eq 0 ]; then
  args=(".")
fi

"${RUFF[@]}" format "${args[@]}"
exec "${RUFF[@]}" check --select I --fix "${args[@]}"
