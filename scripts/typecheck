#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
ros_distro="${ROS_DISTRO:-jazzy}"
ros_setup="/opt/ros/${ros_distro}/setup.bash"
workspace_setup="$repo_root/install/setup.bash"

set +u
if [ -f "$ros_setup" ]; then
  # shellcheck source=/dev/null
  source "$ros_setup"
fi
if [ -f "$workspace_setup" ]; then
  # shellcheck source=/dev/null
  source "$workspace_setup"
fi
set -u

cd "$repo_root"

pipx_bin="${PIPX_BIN_DIR:-$HOME/.local/bin}"
if [ -d "$pipx_bin" ]; then
  PATH="$pipx_bin:$PATH"
fi

if command -v basedpyright >/dev/null 2>&1; then
  exec basedpyright "$@"
fi

if python3 -m basedpyright --version >/dev/null 2>&1; then
  exec python3 -m basedpyright "$@"
fi

if command -v npx >/dev/null 2>&1; then
  exec npx --yes basedpyright "$@"
fi

cat >&2 <<'EOF'
basedpyright is not installed.
Run:
  scripts/setup-dev-tools
EOF
exit 127
