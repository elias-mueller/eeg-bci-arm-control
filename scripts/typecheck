#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=scripts/lib.sh
source "$(dirname -- "${BASH_SOURCE[0]}")/lib.sh"

source_ros_workspace_optional
cd "$repo_root"
prepend_pipx_bin

if command -v basedpyright >/dev/null 2>&1; then
  exec basedpyright "$@"
fi

if python3 -m basedpyright --version >/dev/null 2>&1; then
  exec python3 -m basedpyright "$@"
fi

if command -v npx >/dev/null 2>&1; then
  exec npx --yes basedpyright "$@"
fi

cat >&2 <<'EOF'
basedpyright is not installed.
Run:
  scripts/setup-dev-tools
EOF
exit 127
