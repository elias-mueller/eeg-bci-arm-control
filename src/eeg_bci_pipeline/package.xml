<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>eeg_bci_pipeline</name>
  <version>0.1.0</version>
  <description>EEG publishing, mock and model-backed intent decoding, GDF replay, and offline classifier training.</description>
  <maintainer email="elias.mueller@pm.me">Elias Mueller</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>eeg_bci_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>manipulator_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-mne</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-sklearn</exec_depend>
  <!-- LSL (Lab Streaming Layer) has no apt/rosdep package: liblsl, python3-pylsl,
       and mne-lsl are all absent from the Ubuntu + ROS repos. The LSL nodes
       (lsl_eeg_bridge, lsl_test_outlet) lazy-import pylsl, installed via
       scripts/setup-python-env into the repo .venv; liblsl is the SCCN .deb.
       Intentionally not an exec_depend so rosdep install does not fail on a
       non-resolvable key. -->

  <depend>rclpy</depend>
  <depend>visualization_msgs</depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
